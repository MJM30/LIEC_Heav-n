# ==============================================================================
# LIEC Heav'n Environment Configuration (Subproduction & Production)
# ==============================================================================

# Neon PostgreSQL Database Connections
# Direct connection (primarily for migrations and administrative DDL operations)
DATABASE_URL=

# Pooled connection (recommended for normal serverless application queries)
DATABASE_URL_POOLED=

# Neon Managed Auth endpoint (optional - used only if Neon Auth is enabled)
NEON_AUTH_BASE_URL=

# Neon S3-Compatible Object Storage (optional - for document/attachment uploads)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Neon Realtime Service (optional)
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# Set to "true" to force local embedded PGlite even if DATABASE_URL is configured
FORCE_PGLITE=false

# Port for Next.js HTTP server (default: 3000)
PORT=3000
