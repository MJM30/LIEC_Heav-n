# PostgreSQL Connection String
# Example (Neon / Supabase / AWS RDS / Render):
# DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/liec_heavn?sslmode=require"
DATABASE_URL=

# Set to "true" to force local embedded PGlite even if DATABASE_URL is configured
FORCE_PGLITE=false

# Port for Next.js HTTP server (default: 3000)
PORT=3000
